// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {},
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "g f": "editor::Format",
      "space r": "editor::Rename",
      "space p": "editor::Paste",
      "space x": "editor::Delete",
      "space d d": "editor::DeleteLine",
      "shift-y": ["workspace::SendKeystrokes", "y $"],
    },
  },
  {
    "context": "Editor && vim_mode == visual_line",
    "bindings": {
      "space a": "editor::DeleteLine",
    },
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
      "space p": "editor::Paste",
      "space x": "editor::Delete",
      "space d": "editor::Delete",
      "shift-s": "vim::PushAddSurrounds",
    },
  },
  {
    "context": "Dock",
    "bindings": {
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-v": "editor::Paste",
    },
  },
  {
    "context": "Editor && !menu",
    "bindings": {
      "ctrl-c": "editor::Copy", // vim default: return to normal mode
      "ctrl-x": "editor::Cut", // vim default: decrement
      "ctrl-a": "editor::SelectAll", // vim default: increment
      "ctrl-s": "workspace::Save", // vim default: show signature
    },
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-l": ["vim::Literal", ["ctrl-l", "\f"]],
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-l": "editor::SelectLine",
    },
  },
  {
    "context": "FileFinder || FileFinder > Picker > Editor || FileFinder > Picker > menu",
    "unbind": {
      "ctrl-l": "pane::SplitRight",
    },
  },
  {
    "context": "BufferSearchBar",
    "unbind": {
      "ctrl-l": "search::ToggleSelection",
    },
  },
  {
    "context": "FileFinder || FileFinder > Picker > Editor || FileFinder > Picker > menu",
    "unbind": {
      "ctrl-l": "pane::SplitRight",
    },
  },
  {
    "bindings": {
      "ctrl-l": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-alt-b": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "FileFinder || FileFinder > Picker > Editor || FileFinder > Picker > menu",
    "unbind": {
      "ctrl-l": "pane::SplitRight",
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-u": ["workspace::SendKeystrokes", "1 5 k"],
      "ctrl-d": ["workspace::SendKeystrokes", "1 5 j"],
    },
    "unbind": {
      "ctrl-j": "vim::Down",
    },
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-j": ["vim::Literal", ["ctrl-j", "\n"]],
    },
  },
  {
    "context": "FileFinder || FileFinder > Picker > Editor || FileFinder > Picker > menu",
    "unbind": {
      "ctrl-j": "pane::SplitDown",
    },
  },
  {
    "bindings": {
      "ctrl-j": "workspace::ToggleBottomDock",
    },
  },
  {
    "bindings": {
      "alt-t": "project_symbols::Toggle",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-t": "project_symbols::Toggle",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "alt-t": "task::Rerun",
    },
  },
  {
    "context": "Terminal",
    "unbind": {
      "alt-t": "terminal::RerunTask",
    },
  },
  {
    "bindings": {
      "ctrl-t": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-`": "terminal_panel::Toggle",
    },
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-t": "pane::GoToOlderTag",
    },
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-t": "vim::Indent",
    },
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-t": ["vim::Literal", ["ctrl-t", "\u0014"]],
    },
  },
  {
    "context": "DebugPanel",
    "unbind": {
      "ctrl-t": "debugger::ToggleThreadPicker",
    },
  },
  {
    "context": "KeymapEditor",
    "unbind": {
      "ctrl-t": "keymap_editor::ShowMatchingKeybinds",
    },
  },
  {
    "bindings": {
      "ctrl-alt-r": [
        "projects::OpenRecent",
        {
          "create_new_window": false,
        },
      ],
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-r": [
        "projects::OpenRecent",
        {
          "create_new_window": false,
        },
      ],
    },
  },
  {
    "context": "OutlinePanel && not_editing",
    "unbind": {
      "ctrl-alt-r": "outline_panel::RevealInFileManager",
    },
  },
  {
    "context": "ProjectPanel",
    "unbind": {
      "ctrl-alt-r": "project_panel::RevealInFileManager",
    },
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-alt-r": "terminal::RerunTask",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-shift-k": "editor::DeleteLine",
    },
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "g r": "editor::FindAllReferences",
    },
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "g r r": "editor::FindAllReferences",
    },
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "g shift-a": "editor::FindAllReferences",
    },
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "g i": "editor::GoToImplementation",
    },
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "g i": "editor::GoToImplementation",
    },
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "g shift-i": "editor::GoToImplementation",
    },
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "g r a": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "g .": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "space a": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-x ctrl-l": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "ctrl-k ctrl-z": "editor::ToggleSoftWrap"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "g r": "editor::FindAllReferences"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "alt-shift-f12": "editor::FindAllReferences"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-shift-space": "editor::ShowSignatureHelp"
    }
  },
  {
    "context": "(vim_mode == insert || vim_mode == normal) && showing_signature_help && !showing_completions",
    "unbind": {
      "ctrl-n": "editor::SignatureHelpNext"
    }
  },
  {
    "context": "Editor && showing_signature_help && !showing_completions",
    "bindings": {
      "ctrl-n": "editor::SignatureHelpNext"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "g p": "editor::ShowSignatureHelp"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-i": "editor::ShowSignatureHelp"
    }
  },
  {
    "context": "Editor && showing_signature_help && !showing_completions",
    "bindings": {
      "ctrl-p": "editor::SignatureHelpPrevious"
    }
  },
  {
    "context": "(vim_mode == insert || vim_mode == normal) && showing_signature_help && !showing_completions",
    "unbind": {
      "ctrl-p": "editor::SignatureHelpPrevious"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-g": "vim::ShowLocation"
    }
  },
  {
    "context": "ThreadsSidebar",
    "unbind": {
      "ctrl-g": "agents_sidebar::ToggleThreadHistory"
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "ctrl-g": "go_to_line::Toggle"
    }
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-g": [
        "vim::Literal",
        [
          "ctrl-g",
          "\u0007"
        ]
      ]
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-g": "editor::ShowSignatureHelp"
    }
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-s": "editor::ShowSignatureHelp"
    }
  }
]
